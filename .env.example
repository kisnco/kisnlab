# =============================================================================
# KISNLAB — Variables d'environnement
# =============================================================================
# 1. cp .env.example .env
# 2. Remplace TOUTES les valeurs CHANGE_ME
# 3. NE COMMIT JAMAIS .env dans Git (déjà dans .gitignore)
# =============================================================================

# -----------------------------------------------------------------------------
# TRAEFIK — Dashboard (htpasswd format)
# Génère avec : htpasswd -nb admin monmotdepasse
# ou en ligne : https://www.web2generators.com/apache-tools/htpasswd-generator
# ⚠️ Échappe les $ en $$ dans le .env (ex: $apr1$ → $$apr1$$)
# -----------------------------------------------------------------------------
TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$CHANGE_ME

# -----------------------------------------------------------------------------
# ANTHROPIC — Claude API
# Récupère ta clé : https://console.anthropic.com/settings/keys
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-api03-CHANGE_ME

# -----------------------------------------------------------------------------
# DISCORD — Setup en 3 étapes (voir README section Discord)
#
# Étape 1 : Crée un bot sur https://discord.com/developers/applications
# Étape 2 : Copie le Bot Token ci-dessous
# Étape 3 : Active "Developer Mode" dans Discord (Paramètres → Avancé)
#           puis clic droit sur chaque channel → "Copier l'identifiant"
# -----------------------------------------------------------------------------
DISCORD_BOT_TOKEN=CHANGE_ME_BOT_TOKEN
# Bot dédié à la dev team — identité Discord distincte de KisnLab Bot (Kael).
# Cf. service kisnlab-dev-bot — listener qui forwarde vers /agents/team/run.
DISCORD_DEV_BOT_TOKEN=CHANGE_ME_DEV_TEAM_BOT_TOKEN
DISCORD_GUILD_ID=CHANGE_ME_SERVER_ID
DISCORD_YOUR_USER_ID=CHANGE_ME_TON_USER_DISCORD_ID

# Channels — clic droit sur chaque channel → Copier l'identifiant
DISCORD_CHANNEL_DEV=CHANGE_ME
DISCORD_CHANNEL_COMMERCIAL=CHANGE_ME
DISCORD_CHANNEL_ADMIN=CHANGE_ME
DISCORD_CHANNEL_COMM=CHANGE_ME
DISCORD_CHANNEL_STRATEGIE=CHANGE_ME
DISCORD_CHANNEL_ALERTES=CHANGE_ME
DISCORD_CHANNEL_BRIEFS=CHANGE_ME
DISCORD_CHANNEL_LOGS=CHANGE_ME

# -----------------------------------------------------------------------------
# POSTGRES — Base de données
# -----------------------------------------------------------------------------
POSTGRES_USER=kisnlab_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=kisnlab_main

# -----------------------------------------------------------------------------
# REDIS
# -----------------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# -----------------------------------------------------------------------------
# N8N
# Génère la clé d'encryption : openssl rand -hex 32
# ⚠️ Ne JAMAIS changer N8N_ENCRYPTION_KEY après le 1er lancement
# -----------------------------------------------------------------------------
N8N_USER=admin
N8N_PASSWORD=CHANGE_ME_N8N_PASSWORD
N8N_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32

# -----------------------------------------------------------------------------
# LANGFUSE
# Génère les secrets : openssl rand -base64 32
# Remplis LANGFUSE_PUBLIC_KEY et LANGFUSE_SECRET_KEY APRÈS le 1er lancement
# -----------------------------------------------------------------------------
LANGFUSE_SECRET=CHANGE_ME_openssl_rand_base64_32
LANGFUSE_SALT=CHANGE_ME_openssl_rand_base64_32
LANGFUSE_PUBLIC_KEY=pk-lf-CHANGE_ME
LANGFUSE_SECRET_KEY=sk-lf-CHANGE_ME
LANGFUSE_BASE_URL=http://langfuse.kisnlab.local

# -----------------------------------------------------------------------------
# CLICKHOUSE — Requis pour Langfuse v3
# Génère avec : openssl rand -base64 32
# -----------------------------------------------------------------------------
CLICKHOUSE_PASSWORD=CHANGE_ME_openssl_rand_base64_32

# -----------------------------------------------------------------------------
# MINIO — Blob storage S3-compatible (event uploads Langfuse v3)
# Génère le password : openssl rand -base64 32 (ou python -c "import secrets;print(secrets.token_urlsafe(32))")
# Les mêmes credentials sont réutilisées par langfuse-web/worker pour pousser les events.
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=langfuse-admin
MINIO_ROOT_PASSWORD=CHANGE_ME_openssl_rand_base64_32

# -----------------------------------------------------------------------------
# OPENCLAW — Webhook secret (bridge n8n → OpenClaw)
# Génère avec : openssl rand -base64 32
# -----------------------------------------------------------------------------
OPENCLAW_WEBHOOK_SECRET=CHANGE_ME_openssl_rand_base64_32

# -----------------------------------------------------------------------------
# GITHUB — Token utilisé par OpenClaw (gh CLI) pour ouvrir des PRs draft
#
# ⚠️ RECOMMANDATION SÉCU : utilise un Fine-grained PAT scopé sur l'org `kisnco`.
# https://github.com/settings/personal-access-tokens
# Permissions minimales :
#   - Contents : Read & write   (pour push une branche)
#   - Pull requests : Read & write (pour gh pr create)
#   - Issues : Read & write     (pour gh issue create)
#   - Workflows : Read-only     (PAS de write — sinon escalation possible)
#   - PAS d'accès Secrets, Actions secrets, Administration
# Expiration : 90 jours, à rotater régulièrement.
# -----------------------------------------------------------------------------
GITHUB_TOKEN=ghp_CHANGE_ME

# -----------------------------------------------------------------------------
# DISCORD — Webhooks par channel (pour n8n, sans partager le bot token)
# Dans Discord : Paramètres du channel → Intégrations → Webhooks → Nouveau webhook
# -----------------------------------------------------------------------------
DISCORD_WEBHOOK_ALERTES=https://discord.com/api/webhooks/CHANGE_ME
DISCORD_WEBHOOK_BRIEFS=https://discord.com/api/webhooks/CHANGE_ME
DISCORD_WEBHOOK_LOGS=https://discord.com/api/webhooks/CHANGE_ME
DISCORD_WEBHOOK_ADMIN=https://discord.com/api/webhooks/CHANGE_ME

# -----------------------------------------------------------------------------
# KISNLAB API — Bearer token pour authentifier OpenClaw → kisnlab-api
# Génère avec : openssl rand -hex 32
# -----------------------------------------------------------------------------
KISNLAB_API_TOKEN=CHANGE_ME_openssl_rand_hex_32
